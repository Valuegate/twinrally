[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/Valuegate/twinrally
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "precious-branch"]
	remote = origin
	merge = refs/heads/precious-branch
	vscode-merge-base = origin/main
[branch "twin-rally-swain"]
	github-pr-base-branch = "Valuegate#twinrally#precious-branch"
	vscode-merge-base = origin/precious-branch
	remote = origin
	merge = refs/heads/twin-rally-swain
